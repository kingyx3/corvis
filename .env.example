# Browser runtime
# Local demos must opt in explicitly. Production MUST set this false/omit it.
NEXT_PUBLIC_CORVIS_DEMO_MODE=true
# Leave empty for same-origin /api/v1 routes; set only when using a separate API origin.
NEXT_PUBLIC_CORVIS_API_BASE=

# Server runtime
CORVIS_DEMO_MODE=true

# Enterprise identity gateway / SSO
CORVIS_AUTH_ISSUER=https://idp.example.com/
CORVIS_AUTH_AUDIENCE=corvis
CORVIS_TRUSTED_AUTH_PROXY_SECRET=replace-with-secrets-manager-reference

# Snowflake structured system of record
CORVIS_SNOWFLAKE_SQL_API_URL=https://account.region.snowflakecomputing.com
CORVIS_SNOWFLAKE_OAUTH_TOKEN=replace-with-short-lived-oauth-token-provider
CORVIS_SNOWFLAKE_DATABASE=CORVIS
CORVIS_SNOWFLAKE_WAREHOUSE=CORVIS_APP
CORVIS_SNOWFLAKE_ROLE=CORVIS_APP_ROLE
CORVIS_SNOWFLAKE_DSN=

# Immutable source object store (reference adapter: S3/S3-compatible)
CORVIS_OBJECT_STORE_BUCKET=corvis-prod-documents
CORVIS_S3_REGION=ap-southeast-1
CORVIS_S3_ENDPOINT=
CORVIS_S3_KMS_KEY_ID=replace-with-kms-key-id
CORVIS_AWS_ACCESS_KEY_ID=replace-with-workload-identity-issued-credential
CORVIS_AWS_SECRET_ACCESS_KEY=replace-with-workload-identity-issued-credential
CORVIS_AWS_SESSION_TOKEN=
CORVIS_S3_PRESIGN_TTL_SECONDS=900
CORVIS_MALWARE_SCAN_TAG_KEY=GuardDutyMalwareScanStatus
CORVIS_MALWARE_CLEAN_TAG_VALUE=NO_THREATS_FOUND
CORVIS_MALWARE_THREAT_TAG_VALUE=THREATS_FOUND

# Permissioned retrieval and AI synthesis adapters
CORVIS_SEARCH_ENDPOINT=https://search.internal.example.com
CORVIS_SEARCH_API_TOKEN=replace-with-service-token
CORVIS_AI_ENDPOINT=https://ai.internal.example.com
CORVIS_AI_API_TOKEN=replace-with-service-token

# Observability and external delivery
CORVIS_OBSERVABILITY_ENDPOINT=https://telemetry.internal.example.com/events
CORVIS_OBSERVABILITY_TOKEN=replace-with-service-token
CORVIS_WEBHOOK_SIGNING_SECRET=replace-with-secret
CORVIS_DATA_LIFECYCLE_ENDPOINT=https://lifecycle.internal.example.com
CORVIS_DATA_LIFECYCLE_TOKEN=replace-with-service-token
CORVIS_EXPORT_DELIVERY_ENDPOINT=https://delivery.internal.example.com
CORVIS_EXPORT_DELIVERY_TOKEN=replace-with-service-token
CORVIS_WORKER_SECRET=replace-with-worker-secret

# Never commit actual credentials. Production values must be injected through the
# deployment platform's managed secrets/workload-identity mechanism and rotated.
