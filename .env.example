# Local / developer example only.
# Production values are NOT maintained in this file. See docs/GITHUB_ENVIRONMENTS.md.

# Browser runtime
# Local demos must opt in explicitly. Production MUST set this false/omit it.
NEXT_PUBLIC_CORVIS_DEMO_MODE=true
# Leave empty for same-origin /api/v1 routes; set only when using a separate API origin.
NEXT_PUBLIC_CORVIS_API_BASE=

# Server runtime
CORVIS_DEMO_MODE=true

# Enterprise identity / SSO
CORVIS_AUTH_ISSUER=https://idp.example.com/
CORVIS_AUTH_AUDIENCE=corvis
# Optional: leave empty for standard OIDC discovery.
CORVIS_AUTH_JWKS_URL=
# Optional non-production / identity-broker compatibility secret. The baseline production
# OIDC path verifies bearer tokens directly and does not require this shared secret.
CORVIS_TRUSTED_AUTH_PROXY_SECRET=local-only-placeholder

# Primary structured system of record: Supabase/Postgres
# Local example only. Production CORVIS_POSTGRES_DSN is written directly to the
# Terraform-owned GCP Secret Manager container; do not commit or expose a real DSN.
CORVIS_POSTGRES_DSN=postgresql://user:password@localhost:5432/corvis

# Optional downstream Snowflake analytics/sharing.
# Leave unset unless Snowflake has been explicitly activated.
CORVIS_SNOWFLAKE_SQL_API_URL=
CORVIS_SNOWFLAKE_OAUTH_TOKEN=
CORVIS_SNOWFLAKE_DATABASE=
CORVIS_SNOWFLAKE_WAREHOUSE=
CORVIS_SNOWFLAKE_ROLE=
CORVIS_SNOWFLAKE_DSN=

# Immutable source object store: Google Cloud Storage
CORVIS_OBJECT_STORE_BUCKET=corvis-dev-documents
# Cloud Run uses workload identity. This optional token is only for controlled local /
# integration testing and must never be committed with a real value.
CORVIS_GCP_ACCESS_TOKEN=
CORVIS_GCS_CHUNK_SIZE_BYTES=8388608
CORVIS_UPLOAD_ALLOWED_ORIGINS=http://localhost:3000
CORVIS_MALWARE_SCAN_METADATA_KEY=corvis-malware-status
CORVIS_MALWARE_CLEAN_VALUE=clean
CORVIS_MALWARE_THREAT_VALUE=threat

# Durable processing transport. Production obtains access/identity tokens from the GCP
# metadata and managed-service identity paths. These values are names/URLs, not credentials.
# Terraform derives and injects all of them for deployed API/worker services.
CORVIS_GCP_PROJECT_ID=
CORVIS_GCP_REGION=asia-southeast1
CORVIS_PROCESSING_TOPIC_NAME=
CORVIS_PROCESSING_QUEUE_NAME=
CORVIS_PROCESSING_WORKER_URL=
CORVIS_PROCESSING_WORKER_AUDIENCE=
CORVIS_PROCESSING_WORKER_SERVICE_ACCOUNT=

# Document interpretation / representation worker. The production stage uses keyless
# workload identity to call this Corvis processing endpoint. Leave it unset until the
# environment has an approved representation service; the represented stage then remains
# fail-closed. The endpoint writes deterministic immutable representation objects to the
# configured GCS bucket and returns only lineage metadata to the stage worker.
CORVIS_REPRESENTATION_ENDPOINT=
# Defaults to CORVIS_REPRESENTATION_ENDPOINT when omitted.
CORVIS_REPRESENTATION_AUDIENCE=
# Provider timeout is capped at 25 seconds beneath the stage router's hard timeout.
CORVIS_REPRESENTATION_TIMEOUT_MS=20000

# Governed extraction worker. This adapter is deliberately non-authoritative: it writes a
# deterministic immutable JSONL candidate bundle to GCS and returns bundle/model metadata;
# the Corvis stage worker independently verifies/parses that bundle and persists candidate
# state to Postgres. Leave unset to keep the extracted stage fail-closed.
CORVIS_EXTRACTION_ENDPOINT=
# Defaults to CORVIS_EXTRACTION_ENDPOINT when omitted.
CORVIS_EXTRACTION_AUDIENCE=
# Provider timeout is capped at 25 seconds beneath the stage router's hard timeout.
CORVIS_EXTRACTION_TIMEOUT_MS=20000

# Permissioned retrieval and AI synthesis adapters
CORVIS_SEARCH_ENDPOINT=http://localhost:4100
CORVIS_SEARCH_API_TOKEN=
CORVIS_AI_ENDPOINT=http://localhost:4200
CORVIS_AI_API_TOKEN=

# Observability and external delivery adapters
CORVIS_OBSERVABILITY_ENDPOINT=http://localhost:4300/events
CORVIS_OBSERVABILITY_TOKEN=
CORVIS_DATA_LIFECYCLE_ENDPOINT=http://localhost:4400
CORVIS_DATA_LIFECYCLE_TOKEN=
CORVIS_EXPORT_DELIVERY_ENDPOINT=http://localhost:4500
CORVIS_EXPORT_DELIVERY_TOKEN=
# Local/non-production compatibility only. Production internal worker calls use Google OIDC.
CORVIS_WORKER_SECRET=local-only-placeholder

# Never commit actual credentials. Production human-entered deployment inputs belong in
# GitHub Environment variables/secrets (dev/uat/prod); runtime secrets ultimately live in
# GCP Secret Manager and provider credentials remain CI-only.
