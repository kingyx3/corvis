# Local / developer example only.
# Production values are NOT maintained in this file. See docs/GITHUB_ENVIRONMENTS.md.

# Browser runtime
# Local demos must opt in explicitly. Production MUST set this false/omit it.
NEXT_PUBLIC_CORVIS_DEMO_MODE=true
# Leave empty for same-origin /api/v1 routes; set only when using a separate API origin.
NEXT_PUBLIC_CORVIS_API_BASE=

# Server runtime
CORVIS_DEMO_MODE=true

# Enterprise identity / SSO
CORVIS_AUTH_ISSUER=https://idp.example.com/
CORVIS_AUTH_AUDIENCE=corvis
# Local/integration placeholder only. Production deployment should generate/store the
# runtime value in GCP Secret Manager rather than manually duplicating it in consoles.
CORVIS_TRUSTED_AUTH_PROXY_SECRET=local-only-placeholder

# Primary structured system of record: Supabase/Postgres
# Local example only. Production CORVIS_POSTGRES_DSN is derived/deployed securely and
# stored in GCP Secret Manager; do not commit or expose a real DSN.
CORVIS_POSTGRES_DSN=postgresql://user:password@localhost:5432/corvis

# Optional downstream Snowflake analytics/sharing.
# Leave unset unless Snowflake has been explicitly activated.
CORVIS_SNOWFLAKE_SQL_API_URL=
CORVIS_SNOWFLAKE_OAUTH_TOKEN=
CORVIS_SNOWFLAKE_DATABASE=
CORVIS_SNOWFLAKE_WAREHOUSE=
CORVIS_SNOWFLAKE_ROLE=
CORVIS_SNOWFLAKE_DSN=

# Immutable source object store: Google Cloud Storage
CORVIS_OBJECT_STORE_BUCKET=corvis-dev-documents
# Cloud Run uses workload identity. This optional token is only for controlled local /
# integration testing and must never be committed with a real value.
CORVIS_GCP_ACCESS_TOKEN=
# GCS resumable chunks must be a multiple of 256 KiB. 8 MiB is the default.
CORVIS_GCS_CHUNK_SIZE_BYTES=8388608
# Exact browser origins authorized to receive/use resumable GCS sessions.
CORVIS_UPLOAD_ALLOWED_ORIGINS=http://localhost:3000
# Approved malware scanner writes this custom object metadata disposition.
CORVIS_MALWARE_SCAN_METADATA_KEY=corvis-malware-status
CORVIS_MALWARE_CLEAN_VALUE=clean
CORVIS_MALWARE_THREAT_VALUE=threat

# Permissioned retrieval and AI synthesis adapters
CORVIS_SEARCH_ENDPOINT=http://localhost:4100
CORVIS_SEARCH_API_TOKEN=
CORVIS_AI_ENDPOINT=http://localhost:4200
CORVIS_AI_API_TOKEN=

# Observability and external delivery adapters
CORVIS_OBSERVABILITY_ENDPOINT=http://localhost:4300/events
CORVIS_OBSERVABILITY_TOKEN=
CORVIS_DATA_LIFECYCLE_ENDPOINT=http://localhost:4400
CORVIS_DATA_LIFECYCLE_TOKEN=
CORVIS_EXPORT_DELIVERY_ENDPOINT=http://localhost:4500
CORVIS_EXPORT_DELIVERY_TOKEN=
CORVIS_WORKER_SECRET=local-only-placeholder

# Never commit actual credentials. Production human-entered deployment inputs belong in
# GitHub Environment variables/secrets (dev/uat/prod); runtime secrets ultimately live in
# GCP Secret Manager and provider credentials remain CI-only.
