# Corvis runtime
CORVIS_ENV=development
CORVIS_DEMO_MODE=true
CORVIS_PUBLIC_BASE_URL=http://localhost:3000
CORVIS_SESSION_SECRET=change-me-to-a-long-random-secret-at-least-32-bytes

# Enterprise OIDC (production required)
CORVIS_OIDC_ISSUER=
CORVIS_OIDC_CLIENT_ID=
CORVIS_OIDC_CLIENT_SECRET=
CORVIS_OIDC_REDIRECT_URI=http://localhost:3000/api/auth/callback
CORVIS_OIDC_TENANT_CLAIM=tenant_id
CORVIS_OIDC_ROLES_CLAIM=roles

# Snowflake SQL API / Cortex (production required)
CORVIS_SNOWFLAKE_ACCOUNT_URL=
CORVIS_SNOWFLAKE_TOKEN=
CORVIS_SNOWFLAKE_DATABASE=CORVIS
CORVIS_SNOWFLAKE_WAREHOUSE=CORVIS_SERVING_WH
CORVIS_SNOWFLAKE_ADMIN_ROLE=CORVIS_PLATFORM_SERVICE
CORVIS_CORTEX_SEARCH_DATABASE=CORVIS
CORVIS_CORTEX_SEARCH_SCHEMA=PM_SEMANTIC
CORVIS_CORTEX_SEARCH_SERVICE=DOCUMENT_SEARCH
CORVIS_CORTEX_MODEL=openai-gpt-5

# S3-compatible private object store (production required)
CORVIS_S3_REGION=us-east-1
CORVIS_S3_BUCKET=
# Full bucket endpoint, e.g. https://bucket.s3.us-east-1.amazonaws.com
CORVIS_S3_ENDPOINT=
CORVIS_S3_ACCESS_KEY_ID=
CORVIS_S3_SECRET_ACCESS_KEY=
CORVIS_S3_SESSION_TOKEN=
CORVIS_S3_KMS_KEY_ID=
CORVIS_UPLOAD_PART_SIZE=33554432
CORVIS_PRESIGN_TTL_SECONDS=900
CORVIS_MAX_FILE_BYTES=21474836480

# Browser CSP must allow the exact object-store origin used by presigned multipart PUTs.
NEXT_PUBLIC_CORVIS_UPLOAD_ORIGIN=

# Malware/content scanner. The scanner receives a short-lived presigned object URL and
# must return {clean, sha256, sizeBytes, detectedContentType?, findings?}.
CORVIS_SCANNER_URL=
CORVIS_SCANNER_TOKEN=

# Internal service controls
CORVIS_INTERNAL_WORKER_TOKEN=change-me
CORVIS_SCIM_TOKEN=change-me
CORVIS_SOURCE_RETENTION_DAYS=2555
CORVIS_AUDIT_RETENTION_DAYS=2555
CORVIS_EXPORT_RETENTION_DAYS=7

# Browser application. Production should use same-origin /api/v1 unless an external BFF is deliberate.
NEXT_PUBLIC_CORVIS_API_BASE=/api/v1
# Demo transport is allowed only for non-production builds.
NEXT_PUBLIC_CORVIS_MOCK_API=true
