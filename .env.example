# Browser runtime
# Local demos must opt in explicitly. Production MUST set this false/omit it.
NEXT_PUBLIC_CORVIS_DEMO_MODE=true
# Leave empty for same-origin /api/v1 routes; set only when using a separate API origin.
NEXT_PUBLIC_CORVIS_API_BASE=

# Server runtime
CORVIS_DEMO_MODE=true

# Production identity gateway / enterprise SSO
CORVIS_AUTH_ISSUER=https://idp.example.com/
CORVIS_AUTH_AUDIENCE=corvis
# Random secret shared only between the trusted auth gateway and Corvis app runtime.
CORVIS_TRUSTED_AUTH_PROXY_SECRET=replace-with-secrets-manager-reference

# Production data plane
CORVIS_SNOWFLAKE_DSN=snowflake://account/database
CORVIS_OBJECT_STORE_BUCKET=corvis-prod-sources
CORVIS_SEARCH_ENDPOINT=https://search.example.com

# Never commit actual credentials. Bind secrets through the deployment platform's managed secrets service.
