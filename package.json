{
  "name": "corvis",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test:unit": "node --test \"**/*.test.ts\"",
    "test": "rm -rf .coverage && mkdir -p .coverage && node --test --experimental-test-coverage --test-coverage-include='src/core/**/*.ts' --test-coverage-include='src/lib/**/*.ts' --test-coverage-include='services/control-loop/**/*.ts' --test-coverage-include='src/adapters/upload/**/*.ts' --test-coverage-exclude='**/*.test.ts' --test-coverage-exclude='**/test-support/**' --test-coverage-lines=92.82 --test-coverage-branches=82.03 --test-coverage-functions=89.35 --test-reporter=spec --test-reporter=lcov --test-reporter-destination=stdout --test-reporter-destination=.coverage/lcov.info \"**/*.test.ts\" && node tools/dev/check-changed-coverage.mjs .coverage/lcov.info",
    "test:coverage": "npm test",
    "test:e2e": "playwright test",
    "test:e2e:csp": "CORVIS_E2E_TARGET=production playwright test e2e/content-security-policy.spec.ts",
    "test:e2e:non-demo": "CORVIS_E2E_TARGET=production CORVIS_E2E_DEMO=false playwright test e2e/non-demo-smoke.spec.ts --project=chromium",
    "customer:preflight": "node tools/dev/customer-implementation.ts",
    "verify": "npm run lint && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "hyparquet-writer": "0.16.10",
    "next": "16.3.7",
    "pg": "8.23.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "1.63.0",
    "@types/node": "^26.6.4",
    "@types/pg": "8.23.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "10.12.0",
    "eslint-config-next": "16.3.8",
    "typescript": "^6.0.3"
  }
}
