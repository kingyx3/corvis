{
  "schemaVersion": "corvis.soc1-readiness.v1",
  "authority": {
    "businessControlSource": "Confluence: SOC 1 Readiness, Control Mapping & Audit Plan",
    "technicalImplementationSource": "https://github.com/kingyx3/corvis"
  },
  "target": {
    "report": "SOC 1 Type II",
    "scopeBasis": "controls_likely_relevant_to_user_entities_internal_control_over_financial_reporting",
    "claimState": "readiness_only_until_independent_report_issued"
  },
  "controlObjectives": [
    {
      "id": "FR1",
      "name": "system_governance_and_description",
      "status": "design_present_operating_evidence_required",
      "owners": ["leadership", "operations", "platform-engineering"],
      "evidence": [
        "docs/ARCHITECTURE.md",
        "docs/DATA_PLATFORM.md",
        "Confluence system description and control ownership",
        "auditor-agreed scope and subservice treatment"
      ]
    },
    {
      "id": "FR2",
      "name": "authorized_and_complete_input",
      "status": "implementation_present_live_completeness_evidence_required",
      "owners": ["data-product", "platform-engineering", "data-governance"],
      "evidence": [
        "docs/SOURCE_CONNECTORS.md",
        "source authorization and rights enforcement",
        "ingestion manifests/checksums and expected-source completeness evidence",
        "source acquisition exception records"
      ]
    },
    {
      "id": "FR3",
      "name": "accurate_and_complete_processing",
      "status": "implementation_present_operating_evidence_required",
      "owners": ["data-product", "platform-engineering"],
      "evidence": [
        "durable processing stage implementations",
        "gold-set/regression evidence",
        "source lineage and historical snapshot reproducibility",
        "processing retry/idempotency evidence"
      ]
    },
    {
      "id": "FR4",
      "name": "reconciliation_and_exception_resolution",
      "status": "implementation_present_operating_evidence_required",
      "owners": ["data-product", "operations"],
      "evidence": [
        "db/postgres/migrations/012_reconciliation_resolution.sql",
        "app/api/v1/reconciliation-exceptions",
        "authorized exception resolution records",
        "reconciliation population/completeness evidence"
      ]
    },
    {
      "id": "FR5",
      "name": "review_approval_and_segregation",
      "status": "design_present_role_and_operating_evidence_required",
      "owners": ["data-product", "security", "operations"],
      "evidence": [
        "review and publication authorization paths",
        "tenant-scoped audit events",
        "privileged-operation attribution",
        "auditor-agreed segregation-of-duties evidence or compensating control"
      ]
    },
    {
      "id": "FR6",
      "name": "complete_accurate_and_timely_output",
      "status": "implementation_present_operating_evidence_required",
      "owners": ["data-product", "platform-engineering", "operations"],
      "evidence": [
        "versioned publication/export controls",
        "approved snapshot/version references",
        "output reconciliation and delivery records",
        "correction/republish lineage"
      ]
    },
    {
      "id": "FR7",
      "name": "financially_relevant_change_management",
      "status": "design_strong_live_change_evidence_required",
      "owners": ["platform-engineering", "security", "data-product"],
      "evidence": [
        ".github/workflows/ci.yml",
        ".github/workflows/terraform-deploy.yml",
        "database migration review",
        "model/prompt/configuration regression and release records"
      ]
    },
    {
      "id": "FR8",
      "name": "logical_access_supporting_icfr",
      "status": "provider_gated",
      "owners": ["security", "platform-engineering"],
      "evidence": [
        "Postgres RLS and tenant authorization",
        "service identity boundaries",
        "MFA/SSO/JML evidence",
        "privileged and financially relevant access reviews"
      ]
    },
    {
      "id": "FR9",
      "name": "master_and_configuration_data_integrity",
      "status": "partial_design_operating_evidence_required",
      "owners": ["data-product", "platform-engineering"],
      "evidence": [
        "versioned schema/mapping/configuration records",
        "reporting-period and canonical identity controls",
        "materiality/reference-data change approvals",
        "regression evidence for financially relevant configuration changes"
      ]
    },
    {
      "id": "FR10",
      "name": "error_correction_and_incident_handling",
      "status": "implementation_present_exercise_and_operating_evidence_required",
      "owners": ["operations", "data-product", "security"],
      "evidence": [
        "ops/RUNBOOK.md",
        "versioned correction and replay records",
        "customer-impact/data-quality incident records",
        "root cause, remediation and regression evidence"
      ]
    },
    {
      "id": "FR11",
      "name": "subservice_organizations_and_complementary_controls",
      "status": "auditor_scope_required",
      "owners": ["leadership", "vendor-management", "security", "operations"],
      "evidence": [
        "critical vendor/subprocessor register",
        "subservice assurance/diligence evidence",
        "auditor-agreed carve-out or inclusive treatment",
        "complementary user-entity controls in system description/customer documentation"
      ]
    }
  ],
  "auditGates": [
    "financial_reporting_relevance_confirmed",
    "system_description_and_control_objectives_approved",
    "subservice_and_cuec_treatment_agreed",
    "end_to_end_financially_relevant_data_flow_mapped",
    "production_like_provider_evidence_current",
    "input_completeness_evidenced",
    "review_reconciliation_publication_authorization_evidenced",
    "output_integrity_and_reproducibility_evidenced",
    "access_change_incident_vendor_controls_operating",
    "auditor_readiness_assessment_closed",
    "type_ii_observation_period_completed",
    "independent_report_issued"
  ]
}
