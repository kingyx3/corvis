{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://corvis.example/schemas/customer-implementation-v1.json",
  "title": "Corvis customer implementation manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "customerKey", "environment", "tenantId", "workspaceId", "release", "rights", "providers", "cutover"],
  "properties": {
    "schemaVersion": { "const": "1" },
    "customerKey": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,62}[a-z0-9]$" },
    "environment": { "enum": ["uat", "prod"] },
    "tenantId": { "type": "string", "format": "uuid" },
    "workspaceId": { "type": "string", "format": "uuid" },
    "release": {
      "type": "object", "additionalProperties": false,
      "required": ["commitSha", "imageDigest", "migrationVersion"],
      "properties": {
        "commitSha": { "type": "string", "pattern": "^[0-9a-fA-F]{40}$" },
        "imageDigest": { "type": "string", "pattern": "^sha256:[0-9a-fA-F]{64}$" },
        "migrationVersion": { "type": "integer", "minimum": 1 }
      }
    },
    "rights": {
      "type": "object", "additionalProperties": false,
      "required": ["fundIds", "sourceDocumentAccessAllowed", "redistributionAllowed"],
      "properties": {
        "fundIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "sourceDocumentAccessAllowed": { "type": "boolean" },
        "redistributionAllowed": { "type": "boolean" }
      }
    },
    "providers": {
      "type": "object", "additionalProperties": false,
      "required": ["postgresSecretName", "objectBucket", "sourceConnectionIds", "deliveryWebhookIds"],
      "properties": {
        "postgresSecretName": { "type": "string", "minLength": 1 },
        "objectBucket": { "type": "string", "minLength": 1 },
        "sourceConnectionIds": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "deliveryWebhookIds": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "cutover": {
      "type": "object", "additionalProperties": false,
      "required": ["rollbackImageDigest", "owner", "changeReference"],
      "properties": {
        "rollbackImageDigest": { "type": "string", "pattern": "^sha256:[0-9a-fA-F]{64}$" },
        "owner": { "type": "string", "minLength": 1 },
        "changeReference": { "type": "string", "minLength": 1 }
      }
    }
  }
}
