  },
  "web": {
    "initialPageInteractiveP95Ms": 3000,
    "routeTransitionP95Ms": 1500,
    "adminRefreshP95Ms": 2500
  },
  "processing": {
    "uploadToRegisteredP95Seconds": 15,
    "registeredToReviewReadyP95Minutes": 10,
    "approvedToPublishedP95Minutes": 5
  },
  "load": {
    "concurrentInteractiveUsers": 50,
    "concurrentDocumentJourneys": 20,
    "largeDocumentPages": 500,
