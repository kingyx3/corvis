        "approved policy acknowledgements, confidentiality/IP terms, training records and delegation of authority"
      ]
    },
    {
      "id": "CC2",
      "name": "communication_and_information",
      "status": "operating_evidence_required",
      "owners": ["leadership", "security", "operations"],
